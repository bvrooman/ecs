{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24
  },
  "configurePresets": [
    {
      "name": "dev-config",
      "displayName": "Development Config",
      "description": "Debug build with the development tooling profile.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++-16",
        "ECS_DEV_TOOLING": "ON",
        "ECS_USE_P2996": "ON"
      }
    },
    {
      "name": "release-config",
      "displayName": "Release Config",
      "description": "Release build.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++-16",
        "ECS_DEV_TOOLING": "OFF",
        "ECS_USE_P2996": "ON"
      }
    },
    {
      "name": "asan-config",
      "displayName": "ASan+UBSan (clang, portable reflection)",
      "description": "Debug build of the test suite under AddressSanitizer + UndefinedBehaviorSanitizer.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "ECS_USE_P2996": "OFF",
        "ECS_SANITIZE": "address;undefined",
        "ECS_BUILD_BENCHMARKS": "OFF",
        "ECS_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "tsan-config",
      "displayName": "TSan (clang, portable reflection)",
      "description": "Debug build of the test suite under ThreadSanitizer.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++",
        "ECS_USE_P2996": "OFF",
        "ECS_SANITIZE": "thread",
        "ECS_BUILD_BENCHMARKS": "OFF",
        "ECS_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "wasm-config",
      "displayName": "WASM (Emscripten)",
      "description": "WebAssembly build via a host Emscripten SDK",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-wasm",
      "toolchainFile": "${sourceDir}/../emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ECS_USE_P2996": "OFF",
        "ECS_BUILD_TESTS": "OFF",
        "ECS_BUILD_EXAMPLES": "OFF",
        "ECS_BUILD_BENCHMARKS": "OFF",
        "ECS_BUILD_TOOLS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-build",
      "displayName": "Development Build",
      "configurePreset": "dev-config"
    },
    {
      "name": "release-build",
      "displayName": "Release Build",
      "configurePreset": "release-config"
    },
    {
      "name": "wasm-build",
      "displayName": "WASM Build (all targets)",
      "configurePreset": "wasm-config"
    },
    {
      "name": "asan-build",
      "displayName": "ASan+UBSan Build",
      "configurePreset": "asan-config"
    },
    {
      "name": "tsan-build",
      "displayName": "TSan Build",
      "configurePreset": "tsan-config"
    }
  ]
}
