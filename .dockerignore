# The Dockerfile COPYs nothing into the image, so none of this is needed at
# build time. Excluding it keeps the build context tiny, so `docker build`,
# `docker compose`, and devcontainer rebuilds stay fast (the host build tree and
# stdexec clone under build/ can be hundreds of MB).
.git/
.idea/
build/
cmake-build-*/
.DS_Store
*.log
